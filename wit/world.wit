package sigil:s3@0.2.0;

interface client {
    enum error-class {
        invalid-request,
        transport,
        protocol,
        denied,
        not-found,
        server,
        clock-skew,
        limit,
        unsupported,
    }

    record error {
        class: error-class,
        status: option<u16>,
        message: string,
    }

    record anonymous-auth {
        endpoint: string,
    }

    record presigned-auth {
        endpoint: string,
        query: string,
        authority: string,
    }

    variant auth {
        anonymous(anonymous-auth),
        presigned(presigned-auth),
        sigv4(string),
    }

    record object-options {
        bucket: string,
        key: string,
        auth: auth,
        max-bytes: u32,
    }

    /// HEAD is bounded by the fixed response-header cap rather than by the
    /// represented object's size, so it has no object byte limit input.
    record head-options {
        bucket: string,
        key: string,
        auth: auth,
    }

    /// Metadata returned exactly as the S3-compatible server supplied it.
    /// Missing headers remain `none`; Last-Modified is never parsed or
    /// normalized by the plugin.
    record object-metadata {
        content-length: option<u64>,
        etag: option<string>,
        last-modified: option<string>,
    }

    get-object: func(options: object-options) -> result<list<u8>, error>;
    head-object: func(options: head-options) -> result<object-metadata, error>;
}

world s3 {
    import sigil:host/net@1.0.0;
    import sigil:host/sigv4@1.1.0;
    export client;
}
