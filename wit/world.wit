package sigil:s3@0.1.1;

interface client {
    enum error-class {
        invalid-request,
        transport,
        protocol,
        denied,
        not-found,
        server,
        limit,
        unsupported,
    }

    record error {
        class: error-class,
        status: option<u16>,
        message: string,
    }

    record get-options {
        endpoint: string,
        bucket: string,
        key: string,
        presigned-query: option<string>,
        presigned-authority: option<string>,
        max-bytes: u32,
    }

    get-object: func(options: get-options) -> result<list<u8>, error>;
}

world s3 {
    import sigil:host/net@1.0.0;
    export client;
}
